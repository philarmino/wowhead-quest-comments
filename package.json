{
  "name": "wowhead-quest-comments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch:quests": "tsx scripts/fetch-quest-ids.ts",
    "fetch": "tsx scripts/fetch-comments.ts",
    "process": "tsx scripts/process-comments.ts",
    "generate": "tsx scripts/generate-lua.ts",
    "build:data": "npm run fetch && npm run process && npm run generate",
    "check": "tsc --noEmit",
    "test": "tsx --test scripts/*.test.ts",
    "test:addon": "lua5.1 scripts/addon.test.lua"
  },
  "dependencies": {
    "entities": "^8.1.0"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/node": "^26.6.3",
    "luaparse": "^0.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
